@startuml
title UC-02 · Оформление заказа — диаграмма последовательности

actor "Покупатель" as buyer
participant "Платформа NovaMarket" as platform
participant "Платёжная система" as pay
participant "Логистическая служба" as log
actor "Продавец" as seller

buyer -> platform : Открыть корзину и нажать «Оформить заказ»
platform --> buyer : Состав заказа (товары, количество, цены, итоговая сумма)

buyer -> platform : Подтвердить состав, указать адрес и способ доставки,\n выбрать способ оплаты
platform -> platform : Проверить доступность товаров в нужном количестве
platform -> platform : Зарезервировать доступные товары на складе

platform -> pay : Перенаправить на страницу оплаты
buyer -> pay : Ввести данные карты и подтвердить платёж

alt Платёж успешен
    pay --> platform : Уведомление об успешном списании средств
    platform -> platform : Перевести заказ к этапу подготовки к доставке
    platform -> log : Заявка на доставку (адрес, получатель, список товаров)
    log --> platform : Подтверждение приёма заявки
    platform -> seller : Уведомление о подготовке товара к отправке
    seller --> platform : Подтверждение получения уведомления
    platform --> buyer : Уведомление об успешном оформлении заказа
else Платёж отклонён
    pay --> platform : Ошибка оплаты (недостаточно средств / отказ банка)
    platform --> buyer : Уведомление об отклонении, предложение другого способа оплаты
    note over platform, buyer : Если оплата не завершена — заказ отменяется,\nрезерв на товары снимается
end

@enduml