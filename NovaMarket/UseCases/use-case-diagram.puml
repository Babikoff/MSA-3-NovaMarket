@startuml
title NovaMarket — Диаграмма вариантов использования

left to right direction
skinparam packageStyle rectangle

actor "Покупатель" as buyer
actor "Продавец" as seller
actor "Платёжная система" as pay
actor "Логистическая служба" as log

rectangle "Каталог и заказ" {
    usecase "UC-01\nПросмотр каталога\nи выбор товара" as UC01
    usecase "UC-02\nОформление заказа" as UC02
}

rectangle "Доставка" {
    usecase "UC-03\nОтслеживание статуса\nзаказа (Покупатель)" as UC03
    usecase "UC-04\nОтслеживание заказов\n(Продавец)" as UC04
}

buyer --> UC01
buyer --> UC02
buyer --> UC03
seller --> UC04

UC02 --> pay
UC03 --> log

UC01 ..> UC02 : «include» (корзина из выбора товара используется при оформлении)
@enduml